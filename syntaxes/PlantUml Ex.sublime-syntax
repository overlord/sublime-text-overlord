%YAML 1.2
---
# See http://www.sublimetext.com/docs/3/syntax.html
name: PlantUml Ex
scope: source.puml
version: 2
file_extensions: [puml, uml, wsd]

variables:
  sp: '[ \t]'
  endl: '(?:\n|$)'
  obj_name: '[\w][\w_0-9\.]*'
  component_name_x: '(?: \[ \w [\w_0-9\\\(\)\., ]* \] )'
  var_name: '(?xi) [a-z_] [a-z_0-9]*'
  known_color_x: >-
    (?: AliceBlue | AntiqueWhite | Aqua | Aquamarine | Azure | Beige | Bisque | Black | BlanchedAlmond | Blue | BlueViolet |
    Brown | BurlyWood | CadetBlue | Chartreuse | Chocolate | Coral | CornflowerBlue | Cornsilk | Crimson | Cyan | DarkBlue |
    DarkCyan | DarkGoldenRod | DarkGray | DarkGreen | DarkGrey | DarkKhaki | DarkMagenta | DarkOliveGreen | DarkOrchid | DarkRed |
    DarkSalmon | DarkSeaGreen | DarkSlateBlue | DarkSlateGray | DarkSlateGrey | DarkTurquoise | DarkViolet | Darkorange | DeepPink |
    DeepSkyBlue | DimGray | DimGrey | DodgerBlue | FireBrick | FloralWhite | ForestGreen | Fuchsia | Gainsboro | GhostWhite | Gold |
    GoldenRod | Gray | Green | GreenYellow | Grey | HoneyDew | HotPink | IndianRed | Indigo | Ivory | Khaki | Lavender | LavenderBlush |
    LawnGreen | LemonChiffon | LightBlue | LightCoral | LightCyan | LightGoldenRodYellow | LightGray | LightGreen | LightGrey |
    LightPink | LightSalmon | LightSeaGreen | LightSkyBlue | LightSlateGray | LightSlateGrey | LightSteelBlue | LightYellow | Lime |
    LimeGreen | Linen | Magenta | Maroon | MediumAquaMarine | MediumBlue | MediumOrchid | MediumPurple | MediumSeaGreen |
    MediumSlateBlue | MediumSpringGreen | MediumTurquoise | MediumVioletRed | MidnightBlue | MintCream | MistyRose | Moccasin |
    NavajoWhite | Navy | OldLace | Olive | OliveDrab | Orange | OrangeRed | Orchid | PaleGoldenRod | PaleGreen | PaleTurquoise |
    PaleVioletRed | PapayaWhip | PeachPuff | Peru | Pink | Plum | PowderBlue | Purple | Red | RosyBrown | RoyalBlue | SaddleBrown |
    Salmon | SandyBrown | SeaGreen | SeaShell | Sienna | Silver | SkyBlue | SlateBlue | SlateGray | SlateGrey | Snow | SpringGreen |
    SteelBlue | Tan | Teal | Thistle | Tomato | Turquoise | Violet | Wheat | White | WhiteSmoke | Yellow | YellowGreen )
  color_x: >-
    (?: \# (?: \d+ | [0-9a-f]{6} | {{obj_name}} ) )
  arrow_body_x: >-
    (?: -[DULR]?- | \.[DULR]?\. | -\[ {{color_x}} \]- )
  arrow: >-
    (?xi) (?:
      {{arrow_body_x}} > | -> |
      < {{arrow_body_x}} | <- |
      }o--o{ |
      \|+--\|+ |
      \|+--o{ |
      \|+--o\| |
      --
    )
  brace_quoted_x: >-
    (?: \[ .*? \] | \( .*? \) )
  double_quoted_x: '(?: " .*? " )'

contexts:

  pop-endl:
    - match: $
      pop: true

  main:
    - include: comments
    - include: skin-params

    - include: blocks
    - include: links
    - include: class-members

    - match: >-
        (?xi) \b (
        abstract | actor | artifact | class | cloud | component | database | entity |
        enum | folder | interface | node | object | package | participant | state |
        usecase
        ) \b
      scope: support.function.puml

    # control keywords
    - match: >-
        (?xi) \b (
        activate | again | also | alt | as | autonumber | bottom | box | break | center |
        create | critical | deactivate | destroy | down | else | end | endif | endwhile | footbox |
        footer | fork | group | hide | if | is | left | link | loop | namespace | newpage |
        note | of | on | opt | over | page | par | partition | ref | repeat | return | right |
        rotate | show | skinparam | skin | start | stop | title | top to bottom direction |
        top | up | while
        ) \b
      scope: keyword.control.puml

    - include: colors
    - include: strings

    - match: (?xi) {{component_name_x}}
      scope: constant.string.puml

    - match: (?xi) \b {{obj_name}} \b
      scope: constant.string.puml

    - match: (?xi) \b {{var_name}} \b
      scope: variable.parameter.puml

  # ------------------------------
  comments:
    - match: (?xi) ^ {{sp}}* '
      scope: comment.line.puml
      push:
        - meta_content_scope: comment.line.puml
        - include: pop-endl
    - match: "/'"
      scope: comment.block.puml
      push:
        - meta_content_scope: comment.block.puml
        - match: "'/"
          scope: comment.block.puml
          pop: true

  # ------------------------------
  skin-param-block:
    - match: (?xi) ^ \s* ( skinparam ) ( \s {{obj_name}} )? \s ( \{ )
      captures:
        1: keyword.control.puml
        2: constant.string.puml
        3: punctuation.skin-param.begin.puml
      push:
        - match: \}
          scope: punctuation.skin-param.end.puml
          pop: true
        - match: (?xi) ^ \s* ( {{obj_name}} ) \b
          scope: entity.other.skin-param.key.puml
          push:
            - meta_content_scope: string.other.skin-param.value.puml
            - include: pop-endl

  skin-param-inline:
    - match: (?xi) ^ \s* ( skinparam ) \s ( {{obj_name}} ) \s
      captures:
        1: keyword.control.puml
        2: entity.other.skin-param.key.puml
      push:
        - meta_content_scope: string.other.skin-param.value.puml
        - include: pop-endl

  # ------------------------------
  colors:
    # known colors
    - match: (?xi) \#? {{known_color_x}}
      scope: meta.color-1.puml storage.puml
    - match: '{{color_x}}'
      scope: meta.color-2.puml storage.puml

  # ------------------------------
  links:
    - match: >-
        (?xi) ^
        ( {{obj_name}} | {{component_name_x}} ) \s
        ( ".*?" \s )?
        ( {{arrow}} ) \s
        ( ".*?" \s )?
        ( {{obj_name}} | {{component_name_x}} ) \s?
      scope: meta.link.puml
      captures:
        0: azaza
        1: constant.string.puml
        2: string.quoted.double.puml
        3: keyword.control.puml
        4: string.quoted.double.puml
        5: constant.string.puml
      push:
        - include: pop-endl
        - match: ':'
          scope: keyword.control.puml
          set: link-comment

  link-comment:
    - meta_content_scope: string.puml
    - include: pop-endl
    - match: \\[nt]
      scope: constant.character.escape.puml

  # ------------------------------
  strings:
    - match: \"
      scope: string.quoted.double.puml
      push:
        - meta_content_scope: string.quoted.double.puml
        - match: \"
          scope: string.quoted.double.puml
          pop: true
        - match: \\[nt]
          scope: constant.character.escape.puml

    - match: \'
      scope: string.quoted.single.puml
      push:
        - meta_content_scope: string.quoted.single.puml
        - match: \'
          scope: string.quoted.single.puml
          pop: true
        - match: \\[nt]
          scope: constant.character.escape.puml

  # ------------------------------
  skin-params:
    - include: skin-param-block
    - include: skin-param-inline

  # ------------------------------
  blocks:
    - match: (?x) ^ ( @enduml | @startuml )
      scope: keyword.block.puml
    - match: >-
        (?xi) ^
        ( note )
        (?: \s+ ( as ) \s+ ( {{obj_name}} ) )
      captures:
        1: keyword.puml
        2: keyword.puml
        3: constant.string.puml
      push:
        - meta_content_scope: string.quoted.double.puml
        - match: 'end note'
          scope: keyword.puml
          pop: true
    - match: header
      scope: keyword.puml
      push:
        - meta_content_scope: string.puml
        - match: endheader
          scope: keyword.puml
          pop: true
    - match: (?xi) ^ title \s
      scope: keyword.puml
      push:
        - meta_content_scope: string.quoted.double.puml
        - include: pop-endl
    - include: container-block

  container-block:
    - match: >-
        (?xi) ^
        \s*
        (?: ( package | folder | node | database | component | entity | class | partition | queue | actor | participant | rectangle ) \s+ )
        (?: ( {{double_quoted_x}} ) \s+ ( as ) \s+ ( {{obj_name}} ) \s+ )?
        (?: ( {{double_quoted_x}} ) \s+ )?
        (?: ( {{obj_name}} ) \s+ )?
        (?: ( {{color_x}} ) \s+ )?
      captures:
        1: keyword.puml
        2: string.quoted.double.puml
        3: keyword.puml
        4: constant.string.puml
        5: string.quoted.double.puml
        6: constant.string.puml
        7: meta.color-2.puml storage.puml
      push:
        - match: '{'
          scope: punctuation.begin.puml
          push: container-block-body
        - include: pop-endl

  container-block-body:
    - include: container-block
    - include: class-members
    - match: '}'
      scope: punctuation.end.puml
      pop: true

  # ------------------------------
  class-members:
    - include: class-member-context

  class-member-context:
    - match: >-
        (?xi) ^
        {{sp}}*
        ( -- | == | \.\. )
        {{endl}}
      scope: comment.splitter.puml
    - match: >-
        (?xi) ^
        {{sp}}*
        ( -- | == | \.\. )
        ( .*? )
        ( -- | == | \.\. )
        {{endl}}
      captures:
        1: comment.splitter.puml
        2: comment.block.puml
        3: comment.splitter.puml
    - match: >-
        (?xi) ^ {{sp}}*
        ( \- | \+ | \* | \# )? {{sp}}*
        ( {{obj_name}} | \.\.\. ) {{sp}}*
      scope: meta.class.member.puml
      captures:
        1: punctuation.member-modifier.puml
        2: entity.other.member.puml
      push:
        - include: pop-endl
        - match: ':'
          scope: punctuation.colon.puml
          push: class-member-type-context

  class-member-type-context:
    - meta_content_scope: meta.class.member.type.puml
    - include: pop-endl
    - include: class-member-modifier
    - include: types

  class-member-modifier:
    - match: <<.*?>>
      scope: constant.other.class.member.modifier.puml

  # ------------------------------
  types:
    - include: type-integer
    - include: type-number
    - include: type-bool
    - include: type-float
    - include: type-date
    - include: type-string
    - include: type-raw

  type-integer:
    - match: (?xi) \b ( bigint | integer | int | long )
      scope: keyword.type.puml

  type-number:
    - match: (?xi) \b ( number ) ( {{brace_quoted_x}} )?
      captures:
        1: keyword.type.puml
        2: punctuation.puml

  type-bool:
    - match: (?xi) \b ( boolean | bool )
      captures:
        1: keyword.type.puml
        2: punctuation.puml

  type-float:
    - match: >-
        (?xi) \b ( float (?: 8 )? | double ) ( {{brace_quoted_x}} )?
      captures:
        1: keyword.type.puml
        2: punctuation.puml

  type-date:
    - match: (?xi) \b ( date | timestamptz | timestamp ) ( {{brace_quoted_x}} )?
      captures:
        1: keyword.type.puml
        2: punctuation.puml

  type-string:
    - match: >-
        (?xi) \b (
        string | text | json b? |
        n? clob | n? (?:var)? char 2?
        )
        ( {{brace_quoted_x}} )?
      captures:
        1: keyword.type.puml
        2: punctuation.puml

  type-raw:
    - match: (?xi) \b ( b? lob | raw | rowid ) ( {{brace_quoted_x}} )?
      captures:
        1: keyword.type.puml
        2: punctuation.puml
