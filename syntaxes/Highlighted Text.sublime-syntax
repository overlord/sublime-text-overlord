%YAML 1.2
---
# http://www.sublimetext.com/docs/syntax.html
name: Highlighted Text
file_extensions:
  - txt
  - log
scope: source.plaintext

variables:
  space: '[\x{0020}\t]'
  hex: '[0-9a-f]'
  ip4: '\d{1,3}'
  todo_cancelled: '(?:x)'
  todo_completed: '(?:\+|\*|v|√)'
  todo_pending:   '(?:\-)'
  todo_question:  '(?:\?|\!)'

contexts:

  main:

    # iso datetime: 2021-10-06(T| )17:26:54.9189121Z
    - match: >-
        (?ix)
        \b
        (
          \d{4} [ \. \- / ] \d{2} [ \. \- / ] \d{2} |
          \d{2} [ \. \- / ] \d{2} [ \. \- / ] \d{4}
        )
        (?:
          ( T | {{space}} )
          ( \d{2} : \d{2} (?: : \d{2} (?: \. \d+ )? )? )
          ( Z )?
        )?
        \b
      captures:
        0: markup.quote.plaintext
        1: string.quoted.plaintext
        2: punctuation.plaintext
        3: string.regexp.plaintext
        4: punctuation.plaintext

    # guid
    - match: (?ix) \b ( {{hex}}{32} | {{hex}}{8}-{{hex}}{4}-{{hex}}{4}-{{hex}}{4}-{{hex}}{12} ) \b
      scope: string.guid.plaintext markup.quote.plaintext

    # email
    - match: >-
        (?ix)
        \b
        ( (?: \d | [a-z] | \. | \- | _ )+ )
        ( @ )
        ( (?: \d | [a-z] | \. | \- | _ )+ \. (?: \d | [a-z] | \- )+ )
        \b
      captures:
        0: markup.quote.plaintext
        1: string.email.plaintext
        2: string.punctuation.plaintext
        3: string.email.plaintext

    # domain\username
    - match: >-
        (?ix)
        (?<= ^ | {{space}} | \( )
        ( (?: \d | [a-z] | \. | \- | _ )+ )
        ( \\ )
        ( (?: \d | [a-z] | \. | \- | _ )+ )
        \b
      captures:
        0: markup.quote.plaintext
        1: string.email.plaintext
        2: string.punctuation.plaintext
        3: string.email.plaintext

    # ip-v4
    - match: >-
        (?ix)
        \b
        ( {{ip4}} ) ( \. )
        ( {{ip4}} ) ( \. )
        ( {{ip4}} ) ( \. )
        ( {{ip4}} )
        (?:
          ( \: ) ( \d+ )
        )?
        \b
      captures:
        0: markup.quote.plaintext
        1: string.ip.plaintext
        2: string.punctuation.plaintext
        3: string.ip.plaintext
        4: string.punctuation.plaintext
        5: string.ip.plaintext
        6: string.punctuation.plaintext
        7: string.ip.plaintext
        8: string.punctuation.plaintext
        9: string.regexp.plaintext

    # datetime: 20260617135737, 20211006_172654
    - match: '(?ix) \b ( \d{8} ) ( _ )? ( \d{6} ) \b'
      captures:
        0: markup.quote.plaintext
        1: string.quoted.plaintext
        2: punctuation.plaintext
        3: string.regexp.plaintext

    # splitter line: ------------------------------, ---!---
    - match: '(?ix) ^ {{space}}* -+ !*? -+ {{space}}* $'
      scope: comment.line.plaintext

    # comment line: --- azaza
    - match: '(?ix) ^ \s* ( //!_! | //!!! | /// | ---+ ) .*? $'
      scope: comment.line.plaintext

    # decimal numbers
    - match: '(?i)\b(\d+\.?\d*)[u|f]?\b'
      scope: constant.numeric.decimal.plaintext

    # hexadecimal numbers
    - match: '(?xi) \b 0x [0-9a-f]+ \b'
      scope: constant.numeric.hex.plaintext

    # hexadecimal numbers2
    - match: '(?ix) \b [0-9a-f] [0-9a-f] \b'
      scope: constant.numeric.hex.plaintext

    # amp-escaped chars
    - match: '&[\w_]+\;'
      scope: constant.character.escape.plaintext

    # stages
    - match: >-
        (?xi)
        \b (
          module | dev | (auto-?)? test | demo |
            (telco-?)?
            ( release | int | real | next | (pred?-?)? prod )
            (-?avt | -?grb | -?dr | -?msk )?
        ) \b
      scope: keyword.type.name.plaintext

    # types
    - match: >-
        (?xi) \b (
          array | enum | default |
          bool (ean)? |
          int (eger)? | int\d* | number | long |
          float |
          jsonb | string | text | ( b | n? c )? lob | n? (var)? char 2? |
          date-? time | timestamp (tz)? (\s+ with \s+ time \s+ zone)? | (sys)? date |
          rowid | raw | ODataFilter
        ) \b
      scope: keyword.type.name.plaintext

    # programming language constants
    - match: '(?xi) \b ( true | on | false | off | (not \s+)? null | is ) \b'
      scope: variable.language.plaintext

    - match: '(?xi) \b ( https? | ftp ) \b'
      scope: support.constant.plaintext

    # error markers 1
    - match: '(?xi) \[ ( error | err ) \]'
      scope: invalid.illegal.1.plaintext

    # error markers 2
    - match: '(?xi) \b ( error | err ) (?: \] | ; | , | \s | \n )'
      captures:
        1: invalid.illegal.2.plaintext

    # other error markers
    - match: '(?xi) \[? (?: critical | crit | fatal | exception | \?\?+ | failed ) \]?'
      scope: invalid.illegal.3.plaintext

    # warn markers
    - match: '(?xi) ( \[? (?: warning | \b warn ) \]? ) '
      scope: invalid.illegal.plaintext

    # functions
    - match: '(?xi) \b ( avg | count | min | max | sum ) (?= {{space}}*\( )'
      scope: support.function.aggregate.plaintext

    # header
    - match: >-
        (?xi)
        ^ {{space}}*
        ( \#+ )
        ( {{space}}* )
        ( .*? )
        $
      captures:
        1: markup.heading.plaintext punctuation.definition.bullet.cancelled.todo.plaintext
        2: markup.heading.plaintext
        3: markup.heading.plaintext entity.name.section.plaintext

    # cmd and bash commands
    - match: (?xi) ^ {{space}}* ( > ) {{space}}* ( .*? ) $
      scope: meta.command-line.plaintext
      captures:
        1: support.type.plaintext markup.bold.plaintext
        2: variable.parameter.plaintext markup.quote.plaintext markup.bold.plaintext

    # quoted with back-tick
    - match: (?xi) ( ` ) ( .*? ) ( ` )
      scope: meta.back-tick.quoted.plaintext
      captures:
        1: punctuation.plaintext
        2: variable.parameter.plaintext markup.quote.plaintext markup.bold.plaintext
        3: punctuation.plaintext

    # @reference
    - match: '(?xi) ( @ ) ( (?: \d | \w | _ | - | \. )+ )'
      scope: meta.reference.plaintext
      captures:
        0: markup.quote.plaintext
        1: punctuation.definition.bullet.question.todo
        2: punctuation.plaintext markup.bold.plaintext
        #2: support.function.plaintext markup.bold.plaintext

    # ------------------------------
    # sub-headings
    - match: >-
        (?xi)
        ^ {{space}}*
        (?:
          ( (?: {{todo_question}}+ ) {{space}}+ ) |
          ( (?: {{todo_pending}}   ) {{space}}+ ) |
          ( (?: {{todo_completed}} ) {{space}}+ ) |
          ( (?: {{todo_cancelled}} ) {{space}}+ )
        )?
        ( .*? \: )
        (?= \s )
      captures:
        0: meta.sub-header
        1: punctuation.definition.bullet.question.todo
        2: punctuation.definition.bullet.pending.todo
        3: punctuation.definition.bullet.completed.todo
        4: punctuation.definition.bullet.cancelled.todo
        5: markup.sub-heading.plaintext

    # ------------------------------
    # Todo Bullets
    - match: >-
        (?xi)
        ^ {{space}}*
        (?:
          ( {{todo_question}}+ ) |
          ( {{todo_pending}} ) |
          ( {{todo_completed}} ) |
          ( {{todo_cancelled}} )
        )
        (?= \s )
      captures:
        0: meta.simple-todo
        1: punctuation.definition.bullet.question.todo
        2: punctuation.definition.bullet.pending.todo
        3: punctuation.definition.bullet.completed.todo
        4: punctuation.definition.bullet.cancelled.todo

    # ------------------------------
    # BLABLA (dot) BLABLA
    - match: >-
        (?xi)
        \b
        ( [\w_\-]+ )
        (?: \. ( [\w_\-]+ ) )
        (?: \. ( [\w_\-]+ ) )?
        (?: \. ( [\w_\-]+ ) )?
        (?: \. ( [\w_\-]+ ) )?
        \b
      captures:
        1: support.type.plaintext
        2: support.constant.plaintext
        3: support.constant.plaintext
        4: support.constant.plaintext
        5: support.constant.plaintext

    - match: '(?xi) \b ( localhost ) \b'
      scope: support.type.plaintext

    # math symbols
    - match: >-
        (?xi)
        [
          ! # % , / : < = > ^
          \- \$ \( \) \* \+ \. \[ \\ \] \{ \| \}
        ]+
      scope: meta.math punctuation.plaintext
