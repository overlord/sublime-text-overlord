%YAML 1.2
---
name: Markdown Ex
scope: text.html.markdown
version: 2
extends: Packages/Markdown/Markdown.sublime-syntax

contexts:

  fenced-code-block-body:
    - meta_prepend: true
    - match: |-
        (?xi)
        [ \t]*
        (plantuml|puml)
        {{fenced_code_block_language_break}}
      captures:
        1: constant.other.language-name.markdown
      push:
        - fenced-code-block-plantuml-content
        - fenced-code-block-infostring

  fenced-code-block-plantuml-content:
    - meta_include_prototype: false
    - match: ^
      embed: scope:source.puml
      embed_scope:
        meta.code-fence.body.markdown-gfm
        markup.raw.code-fence.plantuml.markdown-gfm
        source.cs
      escape: (?!)
