[
	// ------------------------------ overlord commands ------------------------------
	{ "keys": ["ctrl+t"],            "command": "overlord_tab", "args": { "indent_type": "tab" } },
	{ "keys": ["ctrl+alt+shift+t"],  "command": "overlord_tab", "args": { "indent_type": "space" } },
	{ "keys": ["ctrl+-"],            "command": "overlord_total_recall", "args": { "mode": "back" } },
	{ "keys": ["ctrl+="],            "command": "overlord_total_recall", "args": { "mode": "forw" } },
	{ "keys": ["ctrl+shift+a"],      "command": "overlord_detect_syntax" },
	{ "keys": ["ctrl+alt+shift+d"],  "command": "overlord_find_all" },
	{ "keys": ["ctrl+w"],            "command": "overlord_close" },
	{ "keys": ["ctrl+alt+shift+-"],  "command": "overlord_insert_string", "args": { "s": "--[ SPLITTER ]--" } },
	{ "keys": ["ctrl+alt+shift+0"],  "command": "overlord_insert_string", "args": { "s": "●" } },
	{ "keys": ["ctrl+shift+-"],      "command": "overlord_insert_string", "args": { "s": "------------------------------" } },
	{ "keys": ["ctrl+shift+="],      "command": "overlord_insert_string", "args": { "s": "----------------------------------!---------------------------------------------" } },
	{ "keys": ["ctrl+shift+;"],      "command": "overlord_insert_time_ymd" },
	{ "keys": ["ctrl+shift+'"],      "command": "overlord_insert_time_ymd_hms" },
	{ "keys": ["ctrl+shift+o"],      "command": "overlord_switch_project" },
	{ "keys": ["ctrl+shift+q"],      "command": "overlord_switch_project_file" },
	// { "keys": ["alt+d"],             "command": "overlord_diff", "args": { "tool": "TortoiseSVN" } },
	// { "keys": ["alt+d"],             "command": "overlord_diff", "args": { "tool": "smerge" } },
	{ "keys": ["alt+d"],             "command": "overlord_diff" },
	{ "keys": ["ctrl+alt+shift+o"],  "command": "overlord_open_recently_closed_file" },
	{ "keys": ["ctrl+k", "ctrl+f"],  "command": "overlord_auto_indent" },
	{ "keys": ["alt+shift+l"],       "command": "reveal_in_side_bar" },
	{ "keys": ["ctrl+shift+h"],      "command": "overlord_replace_plain", "args": { "scratch": false } },
	{ "keys": ["ctrl+e", "ctrl+x"],  "command": "overlord_replace_plain", "args": { "config_path": "${packages}/sublime_overlord/replacers/stack-trace-plain.replace", "scratch": false } },
	{ "keys": ["ctrl+m", "ctrl+o"],  "command": "overlord_sql_outline" },
	//!_!{ "keys": ["ctrl+l"],       "command": "overlord_show_file_list" },
	{ "keys": ["f2"],                "command": "overlord_rename_path" },
	{ "keys": ["ctrl+1"],            "command": "overlord_mark_region", "args": { "command": "add" } },
	{ "keys": ["ctrl+2"],            "command": "overlord_mark_region", "args": { "command": "remove" } },
	{ "keys": ["alt+z"],             "command": "toggle_setting",       "args": { "setting": "word_wrap" } },
	{ "keys": ["ctrl+["],            "command": "overlord_fold_dec" },
	{ "keys": ["ctrl+]"],            "command": "overlord_fold_inc" },
	// ------------------------------ sql-context commands ------------------------------
	{ "keys": ["f12"],               "command": "overlord_goto_definition_plsql", "context": [ { "key": "selector", "operator": "equal", "operand": "source.sql" } ] },
	{ "keys": ["ctrl+g"],            "command": "overlord_goto_line_plsql", "context": [ { "key": "selector", "operator": "equal", "operand": "source.sql" } ] },
	{ "keys": ["ctrl+l", "ctrl+f"],  "command": "overlord_plsql_flip_equal", "context": [ { "key": "selector", "operator": "equal", "operand": "source.sql" } ] },
	// ------------------------------ test commands ------------------------------
	//!_!{ "keys": ["ctrl+t"],       "command": "overlord_test" },
	// ------------------------------ system commands ------------------------------
	{ "keys": ["alt+up"],            "command": "swap_line_up" },
	{ "keys": ["alt+down"],          "command": "swap_line_down" },
	{ "keys": ["ctrl+alt+shift+f1"], "command": "show_scope_name" },
	{ "keys": ["ctrl+shift+e"],      "command": "open_dir", "args": {"dir": "$file_path", "file": "$file_name"} },
	{ "keys": ["f8"],                "command": "permute_lines", "args": {"operation": "unique"} },
	{ "keys": ["ctrl+alt+c"],        "command": "copy_path", "caption": "Copy File Path" },
	{ "keys": ["f1"],                "command": "find_under" },
	{ "keys": ["shift+f1"],          "command": "find_under_prev" },
	{ "keys": ["ctrl+p"],            "command": "overlord_goto_selected_file" },
	{ "keys": ["ctrl+r"],            "command": "overlord_goto_selected_symbol" },
	// { /* dummy last item */ }
]
